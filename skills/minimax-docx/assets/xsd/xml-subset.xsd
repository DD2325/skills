<?xml version="1.0" encoding="UTF-8"?>
<!-- XML Namespace Subset Schema for minimax-docx -->
<!-- Companion to wml-subset.xsd. w:t carries xml:space="preserve" in most real
     documents, but the XML namespace is not built into XmlSchemaSet, so the
     reference has to be satisfied by an import. This is a local, offline
     stand-in for the W3C xml.xsd (https://www.w3.org/2001/xml.xsd); keeping it
     local means validation never needs network access. -->
<!-- MIT License - minimax-docx project -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/XML/1998/namespace"
           elementFormDefault="qualified">

  <xs:attribute name="lang" type="xs:language"/>
  <xs:attribute name="base" type="xs:anyURI"/>
  <xs:attribute name="id" type="xs:ID"/>
  <xs:attribute name="space">
    <xs:simpleType>
      <xs:restriction base="xs:NCName">
        <xs:enumeration value="default"/>
        <xs:enumeration value="preserve"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
</xs:schema>
